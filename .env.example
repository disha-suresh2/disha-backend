# Database file path (relative to backend/)
PG_DB_PATH=data/potencyguard.db

# Enables the demo endpoints (true/false)
PG_DEMO_MODE=true

# Accept a device's public key the first time it sends one (true/false)
PG_TRUST_ON_FIRST_USE=true

# Automatic planning interval per shipment in real seconds (0 disables auto planning)
PG_PLAN_INTERVAL_S=10

# Number of Monte Carlo futures simulated per action
PG_PLAN_SCENARIOS=4000

# CVaR risk tail probability level
PG_CVAR_ALPHA=0.95

# Governance: largest tail loss (CVaR) that may be auto-approved
PG_V_THRESHOLD=3000

# Governance: largest allowed gap between CVaR and expected loss for auto-approval
PG_GAP_THRESHOLD=2500

# Allowed difference between edge potency and backend calculation before warning alert
PG_POTENCY_WARN_TOL=0.002

# Comma-separated list of allowed browser CORS origins
PG_CORS_ORIGINS=*

# SAP integration mode (only mock is supported)
PG_SAP_MODE=mock

# Server host address
PG_HOST=127.0.0.1

# Server port number
PG_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PG_LOG_LEVEL=INFO
